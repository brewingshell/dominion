# dominion configuration.
#
# The server reads this file automatically from, in order:
#   $DOMINION_ENV, ./.env, ~/.config/dominion/.env
# An already-exported DOMINION_PIN, or an explicit -pin flag, takes precedence.
#
# Copy it into place and lock it down:
#   install -Dm600 .env.example ~/.config/dominion/.env

# PIN required to open the portal. Change this.
DOMINION_PIN=1111
