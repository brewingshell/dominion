{
  "name": "dominion-apps",
  "private": true,
  "version": "1.0.0",
  "description": "Native shells (Android + Linux desktop) for the dominion portal.",
  "scripts": {
    "sync": "cap sync",
    "android": "cap sync android && cd android && ./gradlew assembleDebug",
    "electron": "electron .",
    "electron:dist": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/preferences": "^6.0.0"
  },
  "build": {
    "appId": "net.dominion.client",
    "productName": "dominion",
    "files": ["www/**/*", "electron/**/*", "package.json"],
    "linux": {
      "target": ["AppImage"],
      "category": "TerminalEmulator"
    }
  },
  "main": "electron/main.js"
}
