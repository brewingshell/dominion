<?xml version="1.0" encoding="utf-8"?>
<!--
  Trust the bundled dominion CA.

  The portal address is entered by the user at runtime, so it cannot be listed
  as a <domain>; instead the CA is added to base-config, which applies to every
  host. Cleartext is permitted so the app's "connect over plain HTTP" option
  works for a LAN server.

  Copy this to android/app/src/main/res/xml/network_security_config.xml and
  reference it from AndroidManifest.xml (see README). The CA itself is copied
  into res/raw/dominion_ca.pem by sync-ca.sh.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="@raw/dominion_ca" />
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
