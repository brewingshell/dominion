<?xml version="1.0" encoding="utf-8"?>
<!--
  Trust only the bundled dominion CA for the portal host, instead of the public
  CA store. Copy this to android/app/src/main/res/xml/network_security_config.xml
  and reference it from AndroidManifest.xml (see README).

  The CA is copied into res/raw/dominion_ca.pem by sync-ca.sh.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <domain-config cleartextTrafficPermitted="false">
    <!-- Replace with the portal host(s). A wildcard is not allowed. -->
    <domain includeSubdomains="false">YOUR-HOST</domain>
    <trust-anchors>
      <certificates src="@raw/dominion_ca" />
      <certificates src="system" />
    </trust-anchors>
  </domain-config>
</network-security-config>
