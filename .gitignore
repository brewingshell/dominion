# Built binary
/dominion

# Release staging (release.sh)
/dist/

# Local env (PIN etc.)
env
.env

# Logs
*.log

# Node dev tooling
node_modules/

# Client app build projects (generated)
apps/android/
apps/android-overlay/res-raw/

# Desktop client build byproducts
# (apps/desktop/www/ is tracked: go:embed cannot reach ../www, so it is a
# synced copy of apps/www and is committed so the module builds from a clone.)
apps/desktop/.pkgconfig/
apps/desktop/dominion-desktop
apps/desktop/desktop
apps/.appimagetool

# Built client binaries (keep the READMEs, ignore the outputs)
/client_app/*
!/client_app/README.md
*.apk
*.AppImage
*.AppImage.zsync
apps/dist/
apps/android/app/build/
apps/android/.gradle/
apps/android/local.properties
apps/*/builder-debug.yml
linux-unpacked/

# Branding override (kept local)
assets/override_logo.*

# Third-party / personal icon material (not redistributable)
apps/icons/terran*
